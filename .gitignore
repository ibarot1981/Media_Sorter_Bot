# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, type-check, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Local runtime artifacts
*.log
*.db
*.sqlite
*.sqlite3

# App-generated folders: keep placeholders, ignore contents
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# Local config backups and machine-specific overrides
config.yaml
config.backup.*.yaml

# IDE/editor files
.idea/
.vscode/
*.code-workspace

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.build-local-bot-api/

# Test, type-check, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Local runtime artifacts
*.log
*.db
*.sqlite
*.sqlite3

# Keep the built local Bot API runtime files, but ignore its temporary build tree
!telegram-bot-api.exe
!libcrypto-3-x64.dll
!libssl-3-x64.dll
!z.dll

# App-generated folders: keep placeholders, ignore contents
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# Local config backups and machine-specific overrides
config.yaml
config.backup.*.yaml

# IDE/editor files
.idea/
.vscode/
*.code-workspace

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini
